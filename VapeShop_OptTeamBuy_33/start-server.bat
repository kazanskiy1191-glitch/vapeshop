@echo off
powershell -Command "Stop-Job -Name VapeShopServer -ErrorAction SilentlyContinue; Remove-Job -Name VapeShopServer -ErrorAction SilentlyContinue; Start-Job -Name VapeShopServer -ScriptBlock { $h=[System.Net.HttpListener]::new(); $h.Prefixes.Add('http://+:8080/'); $h.Start(); $b='C:\VapeShop_OptTeamBuy_33'; while($h.IsListening){ $c=$h.GetContext(); $p=$c.Request.Url.LocalPath.TrimStart('/'); if(!$p){$p='index.html'}; $f=Join-Path $b $p; if(Test-Path $f){ $d=[IO.File]::ReadAllBytes($f); $e=[IO.Path]::GetExtension($f); $m=@{'.html'='text/html; charset=utf-8';'.css'='text/css; charset=utf-8';'.js'='application/javascript; charset=utf-8'}; $c.Response.ContentType=$m[$e]; if(!$c.Response.ContentType){$c.Response.ContentType='application/octet-stream'}; $c.Response.ContentLength64=$d.Length; $c.Response.OutputStream.Write($d,0,$d.Length) } else { $c.Response.StatusCode=404 }; $c.Response.OutputStream.Close() } }; Start-Process chrome 'http://localhost:8080'; Write-Host 'Server started at http://localhost:8080' -ForegroundColor Green"
